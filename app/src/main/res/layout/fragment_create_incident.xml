<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:background="?android:attr/colorBackground">

    <!-- Incident Report Form Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- INCIDENT REPORT FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOnSurface"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_incident_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/create_incident_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <!-- Captured Photo Preview Attachment Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/pink_primary"
                    app:cardBackgroundColor="?attr/colorSurface">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/iv_captured_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Captured Photo Preview" />

                        <ImageButton
                            android:id="@+id/btn_remove_photo"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_badge_urgent"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white"
                            android:contentDescription="Remove Photo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="8dp"
                            android:background="#99000000"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="📷 Ảnh Đính Kèm Sự Cố"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Title Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_incident_title"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:hintTextColor="@color/pink_primary"
                    app:boxStrokeColor="@color/pink_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_incident_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/incident_title_hint"
                        android:inputType="textCapSentences"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_incident_location"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:hintTextColor="@color/pink_primary"
                    app:boxStrokeColor="@color/pink_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_incident_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/incident_location_hint"
                        android:inputType="textCapWords"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Priority Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/priority_label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_priority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_priority_urgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_urgent"
                        android:padding="10dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/priority_urgent"
                        android:textColor="#C62828"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rb_priority_normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:background="@drawable/bg_badge_processing"
                        android:padding="10dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/priority_normal"
                        android:textColor="#B78103"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rb_priority_low"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pending"
                        android:padding="10dp"
                        android:text="@string/priority_low"
                        android:textColor="#C62828"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <!-- Description Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_incident_desc"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:hintTextColor="@color/pink_primary"
                    app:boxStrokeColor="@color/pink_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_incident_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:hint="@string/incident_desc_hint"
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:minLines="3"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Submit Button with Loading State -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_submit_incident"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gd_button_primary"
                        android:text="@string/btn_submit_incident"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="12dp" />

                    <ProgressBar
                        android:id="@+id/pb_submit_loading"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerInParent="true"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone" />
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>