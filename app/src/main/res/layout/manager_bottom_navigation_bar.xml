<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_m">

    <!-- Horizontal Separator Line directly above Bottom Navigation Bar -->
    <View
        android:id="@+id/nav_divider_line"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.18" />

    <!-- Manager Floating Task Bar Surface Container -->
    <LinearLayout
        android:id="@+id/custom_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nav_bar_height"
        android:background="@drawable/bg_floating_nav_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xs"
        android:paddingEnd="@dimen/spacing_xs"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs">

        <!-- 1. Manager Incidents Tab (Sự Cố) -->
        <LinearLayout
            android:id="@+id/nav_item_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_2xs"
            android:paddingBottom="@dimen/spacing_2xs">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/f7_nav_active"
                android:contentDescription="@string/nav_incidents" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_incidents"
                android:textColor="@color/f7_nav_active"
                android:textSize="@dimen/text_nav_label"
                android:textStyle="bold" />

            <!-- Active Dot Indicator -->
            <View
                android:id="@+id/dot_nav_home"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_active_dot"
                android:visibility="visible" />
        </LinearLayout>

        <!-- 2. Manager Dashboard Tab (Thống Kê) -->
        <LinearLayout
            android:id="@+id/nav_item_explore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_2xs"
            android:paddingBottom="@dimen/spacing_2xs">

            <ImageView
                android:id="@+id/iv_nav_explore"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_nav_explore"
                app:tint="@color/f7_nav"
                android:contentDescription="@string/nav_dashboard" />

            <TextView
                android:id="@+id/tv_nav_explore"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_dashboard"
                android:textColor="@color/f7_nav"
                android:textSize="@dimen/text_nav_label" />

            <View
                android:id="@+id/dot_nav_explore"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_active_dot"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Manager Create / Report Tab (Báo Sự Cố) -->
        <LinearLayout
            android:id="@+id/nav_item_projects"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_2xs"
            android:paddingBottom="@dimen/spacing_2xs">

            <ImageView
                android:id="@+id/iv_nav_projects"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_nav_projects"
                app:tint="@color/f7_nav"
                android:contentDescription="@string/nav_create" />

            <TextView
                android:id="@+id/tv_nav_projects"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_create"
                android:textColor="@color/f7_nav"
                android:textSize="@dimen/text_nav_label" />

            <View
                android:id="@+id/dot_nav_projects"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_active_dot"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 4. Manager Overdue Incidents Tab (Quá Hạn) -->
        <LinearLayout
            android:id="@+id/nav_item_saved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_2xs"
            android:paddingBottom="@dimen/spacing_2xs">

            <ImageView
                android:id="@+id/iv_nav_saved"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_nav_saved"
                app:tint="@color/f7_nav"
                android:contentDescription="@string/nav_overdue" />

            <TextView
                android:id="@+id/tv_nav_saved"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_overdue"
                android:textColor="@color/f7_nav"
                android:textSize="@dimen/text_nav_label" />

            <View
                android:id="@+id/dot_nav_saved"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_active_dot"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5. Manager Profile / Account Tab (Tài Khoản) -->
        <LinearLayout
            android:id="@+id/nav_item_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_2xs"
            android:paddingBottom="@dimen/spacing_2xs">

            <ImageView
                android:id="@+id/iv_nav_profile"
                android:layout_width="@dimen/icon_size_m"
                android:layout_height="@dimen/icon_size_m"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/f7_nav"
                android:contentDescription="@string/nav_profile" />

            <TextView
                android:id="@+id/tv_nav_profile"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:text="@string/nav_profile"
                android:textColor="@color/f7_nav"
                android:textSize="@dimen/text_nav_label" />

            <View
                android:id="@+id/dot_nav_profile"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_active_dot"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>