<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/spacing_l"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thống Kê Tổng Quan Sự Cố"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_screen_title"
            android:textStyle="bold" />

        <!-- Stats Grid Container -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:columnCount="2"
            android:rowCount="3">

            <!-- Total Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOnSurface"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng số sự cố"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tv_stat_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0"
                        android:textColor="@color/pink_primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending Card (Red) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat_pending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOnSurface"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chờ tiếp nhận"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tv_stat_pending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0"
                        android:textColor="@color/status_pending"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Processing Card (Yellow/Amber) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat_processing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOnSurface"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang xử lý"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tv_stat_processing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0"
                        android:textColor="@color/status_processing_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Overdue Card (Red) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat_overdue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="3dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/status_pending"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quá hạn (>24h)"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tv_stat_overdue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0"
                        android:textColor="@color/status_pending"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Completed Card (Green) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_stat_completed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOnSurface"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã hoàn thành"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_secondary" />

                    <TextView
                        android:id="@+id/tv_stat_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0"
                        android:textColor="@color/status_completed"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- System Status Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardCornerRadius="@dimen/radius_l"
            app:cardElevation="4dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/pink_primary"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trạng Thái Hệ Thống Tòa Nhà"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_system_health_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="Hệ thống đang hoạt động ổn định. Đã xử lý 85% sự cố trong vòng 24h."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>