<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BaoCaoSuCo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pink_light</item>
        <item name="colorOnPrimaryContainer">@color/pink_primary_dark</item>

        <item name="colorSecondary">@color/blue_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_light</item>
        <item name="colorOnSecondaryContainer">@color/blue_dark</item>

        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="colorPrimaryDark">@color/primary_dark</item>
    </style>

    <style name="Theme.BaoCaoSuCo" parent="Base.Theme.BaoCaoSuCo" />
</resources>